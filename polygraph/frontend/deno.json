{
  "tasks": {
    "dev": "npm run dev",
    "build": "npm run build",
    "preview": "npm run preview",
    "res:build": "npm run res:build",
    "res:watch": "npm exec rescript -- build -w",
    "res:clean": "npm run res:clean"
  },
  "imports": {
    "@/": "./src/",
    "react": "npm:react@18.3.1",
    "react-dom": "npm:react-dom@18.3.1",
    "react-dom/client": "npm:react-dom@18.3.1/client",
    "graphql": "npm:graphql@16.13.2",
    "@apollo/client": "npm:@apollo/client@3.14.1",
    "@rescript/react": "npm:@rescript/react@0.13.1",
    "rescript": "npm:rescript@12.2.0"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "options": {
      "useTabs": false,
      "lineWidth": 100,
      "indentWidth": 2,
      "singleQuote": false,
      "proseWrap": "preserve"
    }
  }
}
